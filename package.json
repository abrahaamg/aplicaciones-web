{
    "name": "centro-formacion",
    "version": "1.0.0",
    "description": "Plataforma web de gestión de un centro de formación. Práctica obligatoria de Aplicaciones Web.",
    "main": "index.js",
    "private": true,
    "scripts": {
        "start": "node --env-file=.env index.js",
        "dev": "nodemon --exec \"node --env-file=.env\" index.js",
        "cursos": "node listar-cursos.js",
        "datos": "node --env-file=.env db/cargar-datos.js"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "express": "^4.22.3",
        "express-session": "^1.19.0",
        "mariadb": "^3.5.5",
        "morgan": "^1.12.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}
